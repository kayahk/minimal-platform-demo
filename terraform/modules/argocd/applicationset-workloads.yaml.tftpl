apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: registry-workloads
  namespace: argocd
spec:
  goTemplate: true
  goTemplateOptions:
    - missingkey=error
  generators:
    - matrix:
        generators:
          - git:
              repoURL: ${repo_url}
              revision: ${repo_revision}
              files:
                - path: registry/dev/*/*/config.json
          - list:
              elementsYaml: "{{ .spec.environments | toJson }}"
  template:
    metadata:
      name: "{{.projectName}}-{{.serviceName}}-{{.name}}"
      labels:
        platform.demo/project: "{{.projectName}}"
        platform.demo/service: "{{.serviceName}}"
        platform.demo/environment: "{{.name}}"
    spec:
      project: default
      destination:
        server: https://kubernetes.default.svc
        namespace: "{{.projectName}}-{{.name}}"
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true
      sources:
        - repoURL: ${repo_url}
          targetRevision: ${repo_revision}
          path: "{{.spec.source.path}}"
          helm:
            releaseName: "{{.name}}"
            ignoreMissingValueFiles: true
            valueFiles:
              - "$values/{{.spec.valuesSource.path}}/values.yaml"
              - "$values/{{.spec.valuesSource.path}}/values/{{.name}}.yaml"
            values: |
              serviceAccount:
                create: false
                name: {{.projectName}}-{{.serviceName}}-sa
              labels:
                platform.demo/project: {{.projectName}}
                platform.demo/service: {{.serviceName}}
                platform.demo/environment: {{.name}}
              vault:
                enabled: {{.vaultOperator}}
                environment: {{.name}}
                project: {{.projectName}}
                service: {{.serviceName}}
                pathPrefixes: [{{ range $i, $p := .vaultPathPrefixes }}{{ if $i }}, {{ end }}{{ $p }}{{ end }}]
              {{ if .spec.database }}
              database:
                enabled: true
                name: {{.name}}-{{.spec.database.name}}
                secretName: postgres-app
                host: platform-postgres-rw.cnpg-system
              {{ else }}
              database:
                enabled: false
              {{ end }}
        - repoURL: ${repo_url}
          targetRevision: ${repo_revision}
          ref: values
  templatePatch: |
    {{- if .hibernate }}
    spec:
      ignoreDifferences:
        - group: apps
          kind: Deployment
          jsonPointers:
            - /spec/replicas
      syncPolicy:
        syncOptions:
          - CreateNamespace=true
          - RespectIgnoreDifferences=true
    {{- end }}
